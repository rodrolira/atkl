# Base de datos (PostgreSQL)
DB_NAME=atkl_records
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Servidor
PORT=3000
RENDER=false
DB_SSL=false

# Seguridad JWT (requerido, sin valor por defecto)
SECRET=tu-secreto-jwt-aleatorio-y-largo-minimo-32-caracteres

# Email (Nodemailer / Gmail SMTP)
EMAIL=your-account@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Admin inicial (se crea con `pnpm --dir server seed:admin`)
ADMIN_USERNAME=your-admin-username
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-admin-password

# Cloudinary (almacenamiento de imágenes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (almacenamiento de archivos alternativo)
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=your-region
AWS_PUBLIC_KEY=your-access-key-id
AWS_SECRET_KEY=your-secret-access-key

# Frontend (variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000/api
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_CLOUDINARY_FOLDER=your-folder
