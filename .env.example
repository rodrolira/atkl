# Este es el ÚNICO .env que lee el servidor (server/config/loadEnv.js lo carga
# desde la raíz del repo). El cliente usa client/.env aparte, solo con VITE_*.
# Copiar a .env y completar. .env está en .gitignore: nunca se commitea.

# --- Base de datos (PostgreSQL) ---
# Opción A (recomendada, Neon/Supabase): una sola cadena. Si está definida,
# manda ella e ignora las DB_* de abajo. El SSL se activa solo.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# Opción B (Postgres local): borrar DATABASE_URL de arriba y usar estas.
# DB_NAME=atkl_records
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSL=false

# --- Servidor ---
PORT=3000
NODE_ENV=development
# true solo cuando corre en Render (escucha en 0.0.0.0 y fuerza SSL).
RENDER=false

# --- Seguridad JWT (requerido: el server no arranca sin esto) ---
SECRET=generar-con-openssl-rand-hex-32-minimo-32-caracteres

# --- Cloudinary (portadas subidas desde el panel admin) ---
# Las tres hacen falta: config/cloudinary.js las lee por separado.
# CLOUDINARY_URL por sí sola NO sirve.
# Las portadas importadas desde Bandcamp no pasan por acá: se guardan como URL
# del CDN de Bandcamp (f4.bcbits.com) directo en la BD.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Email (formulario de contacto, Nodemailer + Gmail SMTP) ---
EMAIL=tu-cuenta@gmail.com
EMAIL_APP_PASSWORD=tu-app-password-de-gmail

# --- Admin inicial (se crea con: pnpm --dir server seed:admin) ---
ADMIN_USERNAME=tu-usuario-admin
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=una-password-fuerte

# NOTA: el proyecto NO usa AWS/S3. Si ves AWS_* en un .env viejo, son restos de
# una migración abandonada: no hay SDK de AWS instalado y el bucket `atkl` no
# existe. Los archivos están en Bandcamp (audio + portadas) y Cloudinary
# (subidas desde el panel). Tampoco se usan Prisma ni @supabase/supabase-js.
