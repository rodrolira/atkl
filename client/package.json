{
  "name": "atkl-client",
  "version": "1.0.0",
  "description": "ATKL Records — frontend (React + Vite)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "scan": "vite dev & npx react-scan@latest localhost:5173",
    "start": "vite --open",
    "host": "vite --open --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier \"src/**/*.{js,jsx,ts,tsx,css,scss}\" --write",
    "format+lint": "prettier \"src/**/*.{js,jsx,ts,tsx,css,scss}\" --write && eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "vercel-build": "vite build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@iconify/react": "^5.2.0",
    "@loglib/tracker": "^0.8.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@reduxjs/toolkit": "^2.6.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "formik": "^2.4.6",
    "framer-motion": "^11.18.2",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.20.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/classnames": "^2.3.4",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "4.3.3",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "eslint": "^9.11.1"
  }
}